COMPOSE_FILE=compose.yaml

GH_PAGER=""

RUST_BACKTRACE=1
RUST_LOG=warn,nisshi_broker=debug,nisshi_storage=debug,nisshi_schema=debug

# the latest release; use the :edge tag for a build of main
NISSHI_IMAGE=ghcr.io/nisshi-io/nisshi:latest

# Kafka cluster:
CLUSTER_ID="nisshi"

PULL_POLICY=missing

ADVERTISED_LISTENER="localhost:9092"
ADVERTISED_LISTENER_URL="tcp://${ADVERTISED_LISTENER}"

# the default credentials of the local minio in compose.yaml: these are not
# AWS credentials, and no AWS account is needed
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"

AWS_DEFAULT_REGION="eu-west-2"

# use this endpoint when nisshi and minio are both running in docker compose:
AWS_ENDPOINT="http://minio:9000"

# use this endpoint when running nisshi directly from the command line with
# minio running in compose
# AWS_ENDPOINT="http://localhost:9000"

# enable http requests for a local minio
AWS_ALLOW_HTTP="true"

# minio storage engine
# create a bucket "nisshi" at: http://localhost:9001/buckets
# or: mc mb local/nisshi
STORAGE_ENGINE="s3://nisshi/"

# memory storage engine
# STORAGE_ENGINE="memory://nisshi/"

# use this endpoint when nisshi and postgreSQL are both running in docker compose:
# STORAGE_ENGINE="postgres://postgres:postgres@db"

#STORAGE_ENGINE="postgres://postgres:postgres@localhost"

ICEBERG_CATALOG="http://localhost:8181/catalog"
ICEBERG_WAREHOUSE="nisshi"

# the PostgreSQL database that the tests use
# NISSHI_TEST_DATABASE_URL="postgres://postgres:postgres@localhost"

# the host ports of the compose services, as host_ip:host_port:container_port;
# leave host_port empty (127.0.0.1::5432) for a port that Docker picks. In a
# linked worktree, etc/worktree-services.sh sets these, COMPOSE_PROJECT_NAME,
# AWS_ENDPOINT, ICEBERG_CATALOG and NISSHI_TEST_DATABASE_URL here
# NISSHI_DB_PORTS="127.0.0.1:5432:5432"
# NISSHI_MINIO_PORTS="127.0.0.1:9000:9000"
# NISSHI_MINIO_CONSOLE_PORTS="127.0.0.1:9001:9001"
# NISSHI_LAKEHOUSE_PORTS="127.0.0.1:8181:8181"
